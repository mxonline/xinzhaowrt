#!/bin/sh
# Keep LuCI on nginx.  The ImageBuilder package set removes uhttpd; this
# overlay remains defensive for profiles that still carry its init script.

set -eu

log() {
    logger -t xinzhaowrt "$*" || true
}

fail() {
    log "WEBSTACK_FAIL stage=$1"
    exit 1
}

if [ -x /etc/init.d/uhttpd ]; then
    /etc/init.d/uhttpd stop || fail uhttpd_stop
    /etc/init.d/uhttpd disable || fail uhttpd_disable
fi

[ -x /etc/init.d/nginx ] || fail nginx_missing
/etc/init.d/nginx enable || fail nginx_enable
/etc/init.d/nginx restart || fail nginx_restart

log 'WEBSTACK_NGINX_PASS'
log 'WEBSTACK_COMPLETE'
exit 0
