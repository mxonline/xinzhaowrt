#!/bin/sh
# Seed a valid, non-conflicting AdGuard Home configuration on first boot.
# dnsmasq keeps port 53; AdGuard Home's optional local resolver uses 5353.
set -eu

config_file='/etc/adguardhome/adguardhome.yaml'
config_dir='/etc/adguardhome'
if [ ! -s "$config_file" ]; then
    mkdir -m 0700 -p "$config_dir"
    tmp="$config_file.tmp.$$"
    umask 077
    cat > "$tmp" <<'EOF'
http:
  address: 0.0.0.0:3000
dns:
  bind_hosts:
    - 127.0.0.1
  port: 5353
EOF
    mv -f "$tmp" "$config_file"
    if id adguardhome >/dev/null 2>&1; then
        chown adguardhome:adguardhome "$config_file"
    fi
fi
exit 0
