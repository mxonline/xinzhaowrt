#!/bin/sh
# Seed a valid, non-conflicting AdGuard Home configuration on first boot.
# dnsmasq keeps port 53; AdGuard Home's optional local resolver uses 5353.
set -eu

init_dir="${XINZHAO_INIT_DIR:-/etc/init.d}"

disable_service() {
    service="$1"
    init_script="$init_dir/$service"
    [ -x "$init_script" ] || return 0
    "$init_script" stop >/dev/null 2>&1 || true
    "$init_script" disable >/dev/null 2>&1 || true
}

# Reconcile both historical AdGuard Home service names and QuickFile. These
# services may remain enabled across a configuration-preserving sysupgrade.
disable_service adguardhome
disable_service AdGuardHome
disable_service quickfile

config_dir="${XINZHAO_ADGUARD_CONFIG_DIR:-/etc/adguardhome}"
config_file="${XINZHAO_ADGUARD_CONFIG_FILE:-$config_dir/adguardhome.yaml}"
if [ ! -s "$config_file" ]; then
    mkdir -m 0700 -p "$config_dir"
    tmp="$config_file.tmp.$$"
    umask 077
    cat > "$tmp" <<'EOF'
http:
  address: 0.0.0.0:3000
dns:
  bind_hosts:
    - 127.0.0.1
  port: 5353
EOF
    mv -f "$tmp" "$config_file"
    if id adguardhome >/dev/null 2>&1; then
        chown adguardhome:adguardhome "$config_file"
    fi
fi
exit 0
