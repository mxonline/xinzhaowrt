#!/bin/sh /etc/rc.common

# The Arthur image uses Nginx for LuCI.  A profile dependency can still
# install uhttpd, so make its early procd entry point an explicit no-op.
XINZHAO_NGINX_PRIMARY=1
START=50
STOP=10
USE_PROCD=1

start_service() {
    return 0
}

stop_service() {
    return 0
}

reload_service() {
    return 0
}
