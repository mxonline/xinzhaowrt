#!/bin/sh
set -eu

if [ "$#" -ne 4 ]; then
  echo "Usage: $0 ACTIVE_CONFIG META_CORE SMART_CORE SMART_SHA256_FILE" >&2
  exit 64
fi

active_config="$1"
meta_core="$2"
smart_core="$3"
smart_sha_file="$4"

[ -s "$active_config" ] || {
  echo "OpenClash core selection failed: active config is missing or empty" >&2
  exit 1
}

if grep -Eq "^[[:space:]]*(-[[:space:]]*)?type:[[:space:]]*['\"]?smart['\"]?([[:space:]#]|$)" "$active_config" || \
   grep -Eq "[,{][[:space:]]*type:[[:space:]]*['\"]?smart['\"]?([[:space:]#},]|$)" "$active_config"; then
  [ -x "$smart_core" ] || {
    echo "OpenClash Smart Core required by active config is missing or not executable" >&2
    exit 1
  }
  [ -s "$smart_sha_file" ] || {
    echo "OpenClash Smart Core SHA-256 pin is missing" >&2
    exit 1
  }
  expected_sha="$(awk 'BEGIN { ORS = "" } { gsub(/[[:space:]]/, ""); printf "%s", $0 }' "$smart_sha_file")"
  case "$expected_sha" in
    *[!0-9a-fA-F]*|'')
      echo "OpenClash Smart Core SHA-256 pin is malformed" >&2
      exit 1
      ;;
  esac
  [ "${#expected_sha}" -eq 64 ] || {
    echo "OpenClash Smart Core SHA-256 pin is malformed" >&2
    exit 1
  }
  actual_sha="$(sha256sum "$smart_core" 2>/dev/null | awk '{print $1}')"
  case "$actual_sha" in
    \\*) actual_sha="${actual_sha#\\}" ;;
  esac
  [ "$actual_sha" = "$expected_sha" ] || {
    echo "OpenClash Smart Core SHA-256 mismatch (expected=$expected_sha actual=$actual_sha); refusing Meta fallback" >&2
    exit 1
  }
  printf '%s\n' "$smart_core"
  exit 0
fi

[ -x "$meta_core" ] || {
  echo "OpenClash Meta Core is missing or not executable" >&2
  exit 1
}
printf '%s\n' "$meta_core"
