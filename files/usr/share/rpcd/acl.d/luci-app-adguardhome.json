{
  "luci-app-adguardhome": {
    "description": "AdGuard Home LuCI manager",
    "read": {
      "ubus": {
        "luci": ["getInitList"],
        "network.interface.lan": ["status"],
        "file": ["read", "stat", "exec"]
      },
      "uci": ["AdGuardHome"],
      "file": {
        "/etc/AdGuardHome.yaml": ["read"],
        "/etc/AdGuardHome.yaml.xinzhao-backup": ["read"],
        "/usr/bin/AdGuardHome --version": ["exec"],
        "/usr/bin/AdGuardHome --check-config --config /etc/AdGuardHome.yaml": ["exec"],
        "/usr/bin/logread -e AdGuardHome": ["exec"]
      }
    },
    "write": {
      "ubus": {
        "luci": ["setInitAction"],
        "file": ["read", "write", "stat", "exec"]
      },
      "uci": ["AdGuardHome"],
      "file": {
        "/etc/AdGuardHome.yaml": ["read", "write"],
        "/etc/AdGuardHome.yaml.xinzhao-backup": ["read", "write"],
        "/tmp/AdGuardHome.log": ["write"],
        "/bin/cp *": ["exec"],
        "/usr/bin/AdGuardHome --check-config --config /etc/AdGuardHome.yaml": ["exec"]
      }
    }
  }
}
