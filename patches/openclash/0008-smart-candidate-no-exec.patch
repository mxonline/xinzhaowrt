 RUN_DIR="$RUN_ROOT/$$"
 LOCK_ACQUIRED=0
 
+validate_candidate() {
+   "$1" -v 2>&1
+}
+
 set_lock() {
@@ -186,12 +190,19 @@
                   [ "$extract_success" = "true" ] && { extract_err=$(chmod 4755 "$TMP_FILE" 2>&1) || extract_success=false; }
                   if [ "$extract_success" = "true" ]; then
