diff --git a/luci-app-openclash/root/usr/share/openclash/openclash_debug_dns.lua b/luci-app-openclash/root/usr/share/openclash/openclash_debug_dns.lua
--- a/luci-app-openclash/root/usr/share/openclash/openclash_debug_dns.lua
+++ b/luci-app-openclash/root/usr/share/openclash/openclash_debug_dns.lua
@@ -1,5 +1,40 @@
 #!/usr/bin/lua
 
+local addr = arg[1]
+local resolve = arg[2]
+
+local function shell_quote(value)
+   return "'" .. tostring(value or ""):gsub("'", "'\\''") .. "'"
+end
+
+if resolve == "true" then
+   local function read_uci(option)
+      local pipe = io.popen("uci -q get " .. option .. " 2>/dev/null")
+      if not pipe then return "" end
+      local value = pipe:read("*a") or ""
+      pipe:close()
+      return value:gsub("%s+$", "")
+   end
+
+   local lan_ip = read_uci("network.lan.ipaddr")
+   local port = read_uci("openclash.config.cn_port")
+   local passwd = read_uci("openclash.config.dashboard_password")
+   if lan_ip ~= "" and port ~= "" and addr and addr ~= "" then
+      local url = "http://" .. shell_quote(lan_ip) .. ":" .. shell_quote(port) .. "/dns/query?name=" .. shell_quote(addr)
+      local command = "curl -sL -m 3 -H " .. shell_quote("Content-Type: application/json") ..
+         " -H " .. shell_quote("Authorization: Bearer " .. passwd) .. " " .. url ..
+         " 2>/dev/null | sed -n 's/.*\"data\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p'"
+      local pipe = io.popen(command)
+      if pipe then
+         for line in pipe:lines() do
+            if line ~= "" then print(line) end
+         end
+         pipe:close()
+      end
+   end
+   os.exit(0)
+end
+
 require "nixio"
 require "luci.util"
 require "luci.sys"
