diff --git a/luci-app-openclash/root/usr/share/openclash/openclash_core.sh b/luci-app-openclash/root/usr/share/openclash/openclash_core.sh
--- a/luci-app-openclash/root/usr/share/openclash/openclash_core.sh
+++ b/luci-app-openclash/root/usr/share/openclash/openclash_core.sh
@@ -5,14 +5,51 @@
 . /usr/share/openclash/openclash_curl.sh
 . /usr/share/openclash/openclash_ps.sh
 
+LOCK_DIR="/tmp/lock"
+LOCK_FILE="$LOCK_DIR/openclash_core.lock"
+RUN_ROOT="/tmp/openclash-core-update"
+RUN_DIR="$RUN_ROOT/$$"
+LOCK_ACQUIRED=0
+
 set_lock() {
-   exec 872>"/tmp/lock/openclash_core.lock" 2>/dev/null
-   flock -x 872 2>/dev/null
+   command -v flock >/dev/null 2>&1 || {
+      LOG_ERROR "Core updater lock unavailable: flock is not installed"
+      exit 1
+   }
+   mkdir -p "$LOCK_DIR" || {
+      LOG_ERROR "Core updater lock unavailable: cannot create $LOCK_DIR"
+      exit 1
+   }
+   exec 872>"$LOCK_FILE" 2>/dev/null || {
+      LOG_ERROR "Core updater lock unavailable: cannot open $LOCK_FILE"
+      exit 1
+   }
+   if ! flock -x 872 2>/dev/null; then
+      LOG_ERROR "Core updater lock unavailable: flock acquisition failed"
+      exec 872>&- 2>/dev/null || true
+      exit 1
+   fi
+   LOCK_ACQUIRED=1
+   mkdir -p "$RUN_ROOT" || {
+      LOG_ERROR "Core updater temporary directory unavailable: cannot create $RUN_ROOT"
+      del_lock
+      exit 1
+   }
+   rm -rf "$RUN_DIR"
+   mkdir "$RUN_DIR" || {
+      LOG_ERROR "Core updater temporary directory unavailable: cannot create $RUN_DIR"
+      del_lock
+      exit 1
+   }
 }
 
 del_lock() {
-   flock -u 872 2>/dev/null
-   rm -rf "/tmp/lock/openclash_core.lock" 2>/dev/null
+   rm -rf "$RUN_DIR" 2>/dev/null || true
+   if [ "$LOCK_ACQUIRED" = "1" ]; then
+      flock -u 872 2>/dev/null || true
+      exec 872>&- 2>/dev/null || true
+      LOCK_ACQUIRED=0
+   fi
 }
 
 set_lock
@@ -79,17 +116,17 @@
 
