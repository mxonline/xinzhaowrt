# 新肇网络Wrt-京东云亚瑟固件 v0.1.0 build seed
# Device: JDCloud RE-SS-01 / Arthur. 64G is eMMC capacity, not a separate target.

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_VERSION_DIST="XinZhaoWrt"
CONFIG_VERSION_NUMBER="0.1.0"
CONFIG_VERSION_MANUFACTURER="XinZhao Network"
CONFIG_VERSION_PRODUCT="JDCloud Arthur RE-SS-01"

# Web UI / language
# QuickFile requires luci-nginx; use one web stack instead of running uhttpd + nginx together.
CONFIG_PACKAGE_luci-nginx=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Required LuCI apps: all 22 are hard requirements.
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-wol=y

# EasyTier core + TUN
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_kmod-tun=y

# OpenClash common runtime dependencies
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y

# DiskMan / storage practical tools
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_kmod-md-linear=y
CONFIG_PACKAGE_kmod-md-raid456=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mount-utils=y

# USB storage helpers; harmless if unused and useful for external disks.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y

# Diagnostics
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y

# Build acceleration for repeated cloud/local builds
CONFIG_CCACHE=y
