{
  "schema_version": 1,
  "policy_id": "fast-safe-release",
  "policy_version": "1.1.0",
  "success_terminal_state": "PRODUCTION_RELEASED",
  "recovery_law": "REUSE_RECONCILE_REPAIR_CONTINUE",
  "production_stage_model": "RELEASE_FIRST_V3",
  "allow_new_production_stages": false,
  "release_checkpoint_order": [
    "PREVIEW_ACCEPTED",
    "LOCAL_CHANGES_CAPTURED",
    "STATIC_VERIFIED",
    "SOURCE_FROZEN",
    "REMOTE_INTEGRATED",
    "BUILD_DISPATCHED",
    "CONTROLLER_ATTACHED",
    "PRODUCTION_RUNNING",
    "PRODUCTION_RELEASED"
  ],
  "production_stage_order": [
    "RECOVER_CURRENT_RELEASE_STATE",
    "DETERMINE_MINIMUM_CHANGE_SCOPE",
    "CHANGE_IMPACT_GATE",
    "BASELINE_INHERITANCE_GATE",
    "EXPECTED_DIFF_GATE",
    "CHOOSE_FASTEST_RELIABLE_BUILD_PATH",
    "BUILD",
    "ARTIFACT_INTEGRITY_CHECKS",
    "AUTO_FLASH_SAFETY_GATE",
    "WINDOWS_POWERSHELL",
    "OPENSSH_UPLOAD",
    "REMOTE_SHA256",
    "SYSUPGRADE",
    "WAIT_DEVICE",
    "REAL_DEVICE_VERIFY",
    "RELEASE_GATE",
    "GITHUB_RELEASE",
    "PRODUCTION_RELEASED"
  ],
  "impact_classes": [
    "DOC_ONLY",
    "CONTROL_PLANE_ONLY",
    "PREVIEW_BYTES",
    "FIRMWARE_INPUT",
    "DEVICE_WRITE_POLICY"
  ],
  "convergence_contract": {
    "failure_set_required_before_build": true,
    "failure_set_required_state": "RESOLVED",
    "rootfs_offline_acceptance_required_before_build": true,
    "firmware_input_fingerprint_binding_required": true,
    "cancel_active_build_if_failure_set_unresolved": true,
    "candidate_acceptance_required_before_flash": true,
    "single_flash_chain_required": true,
    "clean_postflash_required_for_release": true,
    "postflash_mutation_denies_release": true,
    "new_postflash_failure_requires_contract_gap_closure_before_rebuild": true
  },
  "circuit_breaker": {
    "same_failure_without_progress_max_attempts": 2
  }
}
