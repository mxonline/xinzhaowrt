{
  "schema_version": 1,
  "device": {
    "board_pattern": "jdcloud,re-ss-01|RE-SS-01",
    "management_ip": "192.168.6.1"
  },
  "backup_root": "/root/xinzhaowrt-live-preview",
  "source_mappings": [
    {
      "repo_prefix": "files/www/luci-static/",
      "remote_prefix": "/www/luci-static/"
    },
    {
      "repo_prefix": "files/usr/share/rpcd/acl.d/",
      "remote_prefix": "/usr/share/rpcd/acl.d/"
    },
    {
      "repo_prefix": "sources/kenzok8/quickstart/htdocs/luci-static/",
      "remote_prefix": "/www/luci-static/"
    },
    {
      "repo_prefix": "sources/kenzok8/quickstart/root/usr/share/rpcd/acl.d/",
      "remote_prefix": "/usr/share/rpcd/acl.d/"
    },
    {
      "repo_prefix": "sources/kenzok8/quickstart/root/usr/share/luci/menu.d/",
      "remote_prefix": "/usr/share/luci/menu.d/"
    }
  ],
  "allowed_remote_prefixes": [
    "/www/luci-static/",
    "/usr/share/rpcd/acl.d/",
    "/usr/share/luci/menu.d/",
    "/usr/share/AdGuardHome/",
    "/usr/lib/lua/luci/model/cbi/AdGuardHome/",
    "/usr/lib/lua/luci/view/AdGuardHome/",
    "/usr/lib/lua/luci/view/quickstart/",
    "/usr/libexec/quickstart/"
  ],
  "allowed_remote_exact": [
    "/etc/init.d/AdGuardHome",
    "/etc/config/AdGuardHome",
    "/etc/AdGuardHome.yaml",
    "/usr/lib/lua/luci/controller/AdGuardHome.lua",
    "/usr/lib/lua/luci/i18n/adguardhome.zh-cn.lmo",
    "/usr/lib/lua/luci/controller/quickstart.lua",
    "/usr/lib/lua/luci/controller/istore_backend.lua"
  ],
  "forbidden_repo_prefixes": [
    "config/",
    "files/etc/config/network",
    "files/etc/config/wireless",
    "files/etc/uci-defaults/",
    "files/etc/init.d/",
    "patches/",
    "package/",
    "packages/",
    "feeds/",
    "target/",
    "VERSION",
    "build.env"
  ],
  "forbidden_remote_prefixes": [
    "/etc/config/wireless",
    "/etc/config/network",
    "/etc/config/firewall",
    "/etc/init.d/",
    "/lib/",
    "/usr/bin/",
    "/usr/sbin/",
    "/sbin/",
    "/boot/",
    "/dev/",
    "/sys/",
    "/proc/"
  ],
  "luci_cache_paths": [
    "/tmp/luci-indexcache",
    "/tmp/luci-indexcache.*",
    "/tmp/luci-modulecache/*"
  ],
  "adguard_route": "admin/services/AdGuardHome/overview",
  "adguard_status_route": "admin/services/AdGuardHome/status",
  "adguard_base_route": "admin/services/AdGuardHome/base",
  "adguard_tools_route": "admin/services/AdGuardHome/tools",
  "adguard_log_route": "admin/services/AdGuardHome/log",
  "adguard_manual_route": "admin/services/AdGuardHome/manual",
  "adguard_web_port": 3000,
  "quickstart_route": "admin/quickstart/"
}
